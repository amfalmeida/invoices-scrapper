# Comma-separated list of enabled providers
PROVIDERS=lidl

# Timezone for log timestamps. Each start does one pass; schedule it externally
# (Home Assistant automation, or cron).
TZ=Europe/Lisbon
# Log what would be sent without sending or marking anything as sent
DRY_RUN=false
# Ignore invoices older than this date (YYYY-MM-DD). Avoids sending your whole history on first run.
SINCE_DATE=
LOG_LEVEL=INFO
# Sent-invoice database and Lidl token. Default: state.db inside DATA_DIR (./data locally, /data in docker)
# DB_PATH=./data/state.db

# --- mail-hawk ---
# From Docker, a mail-hawk running on the host is http://host.docker.internal:8081
MAILHAWK_URL=http://localhost:8081
# Must match APP_API_KEY in mail-hawk (which also needs APP_API_ENABLED=true)
MAILHAWK_API_KEY=
MAILHAWK_TIMEOUT=30

# --- Lidl Plus ---
# Get it with: make lidl-auth (fills this in automatically; needs Firefox or Chrome)
# After the first run, the rotated token is stored in the state database (DB_PATH) and this value is no longer used.
LIDL_REFRESH_TOKEN=
LIDL_LANGUAGE=pt
LIDL_COUNTRY=PT
# Entity (payee) name sent to mail-hawk
LIDL_ENTITY_NAME=Lidl
# Lidl Plus app version sent to the API; bump it if requests start hanging or failing
LIDL_APP_VERSION=16.45.5
